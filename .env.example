# Template only: real values go in .env on the server (git-ignored). Never commit real keys.
# BYOK=true (default, for a public site): every visitor enters their own Gemini + Tavily keys in the page.
# The two server keys below are then NEVER used and can stay blank.
BYOK=true
# Only for a private instance (BYOK=false): your own keys. Two Gemini keys rotate on 429s.
GEMINI_API_KEYS=
TAVILY_API_KEY=
# Blank = auto-pick newest free Flash-Lite model
GEMINI_MODEL=
POSTGRES_PASSWORD=change-me          # install.sh replaces this with a random one
# Optional: a long random string unlocks /api/usage and /api/history (header X-Admin-Token). Blank = off.
ADMIN_TOKEN=
# Safety caps (free tiers): Gemini per key per UTC day, Tavily per month
GEMINI_DAILY_CAP=400
TAVILY_MONTHLY_CAP=900
PER_IP_HOURLY_LIMIT=15
PUBLIC_PORT=80
